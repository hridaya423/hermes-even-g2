HERMES_G2_HERMES_ORIGIN=http://127.0.0.1:8642
HERMES_G2_HERMES_API_KEY=generate-a-long-random-master-key
HERMES_G2_PLUGIN_SECRET=generate-an-independent-plugin-secret
HERMES_G2_DATABASE_PATH=/var/lib/hermes-g2/hermes-g2.db
HERMES_G2_WHISPER_BINARY=/opt/homebrew/bin/whisper-cli
HERMES_G2_WHISPER_MODEL=/var/lib/hermes-g2/models/ggml-base.en-q5_1.bin
HERMES_G2_BIND_HOST=127.0.0.1
HERMES_G2_BIND_PORT=8765

