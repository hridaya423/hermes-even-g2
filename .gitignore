.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.gradle/
node_modules/
dist/
build/
.build/
*.tsbuildinfo
*.db
*.db-shm
*.db-wal
*.ehpk
*.apk
local.properties

# Release bundles are separate from transient build output. Their hashes pin
# the exact EHPK/APK that was verified and can be committed or published.
!release/
!release/*.ehpk
!release/*.apk
!release/*.json
!release/SHA256SUMS
